# Copy this file to .env and fill in your Snowflake credentials
# Do NOT commit your real .env file to source control.

# Snowflake connection
SNOW_USER=your_snowflake_user
SNOW_PASSWORD=your_snowflake_password
SNOW_ACCOUNT=your_snowflake_account

# Optional overrides
SNOW_WAREHOUSE=COMPUTE_WH
SNOW_DATABASE=TEST1
SNOW_SCHEMA=STREAM

# Example: export SNOW_USER=alice  (Linux/macOS)
# Example (PowerShell): $env:SNOW_USER = "alice"
# For local development, use a .env loader or set environment variables in your shell/IDE.
